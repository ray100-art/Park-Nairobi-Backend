# Copy to .env and fill in values before: docker compose up -d --build

# Required
DB_PASSWORD=change_me_strong_db_password
JWT_SECRET=change_me_at_least_32_characters_long_secret

# Public URL of your site (used for CORS and M-Pesa callbacks)
# Example: https://parknairobi.yourdomain.com
SITE_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# M-Pesa (Safaricom Daraja) — required for payments
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_CALLBACK_SECRET=your_callback_secret

# Optional
HTTP_PORT=80
PARKING_FEE_AMOUNT=50
JWT_EXPIRATION=86400000
